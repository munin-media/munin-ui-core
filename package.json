{
  "name": "@munin-media/ui-core",
  "version": "1.0.2",
  "description": "Component contracts and shared logic for Munin UI renderers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@munin-media/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@munin-media/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@munin-media/core": "^1.0.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/munin-media/munin-ui-core.git"
  }
}
